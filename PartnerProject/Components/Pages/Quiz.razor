    public void click()
    {
        checkAnswer();

        // Reset selectedAnswer and force UI update
        selectedAnswer = -1;
        StateHasChanged();

        // Remove the question and get a new one
        Questions.Remove(Questions[randomIndex]);
        GenerateRandomIndex();
        UpdateAmount();
    }
    private void checkAnswer()
    {


