@page "/quiz"
@rendermode InteractiveServer
@using PartnerProject.Models
<p>Hello</p>
<div style="display: flex; justify-content: space-between; width: 100%;">

    <h3>Random Quiz</h3>
    <h3>Correct Answers: @correctAnswers</h3>
</div>


<CascadingValue Value="randomIndex">
</CascadingValue>
<div style="display: block; width: fit-content;">

    @if (Questions[randomIndex] != null)
    {
        <CascadingValue Value="Questions[randomIndex]">
            <Question />
        </CascadingValue>

    }
    <div style="display: flex; justify-content: space-between; width: 100%;">

        <FluentButton @onclick="click">Submit</FluentButton>
        <FluentButton @onclick="stop">Stop</FluentButton>
    </div>
</div>




